# ==========================================
# UTILITY + AD PLATFORM ENVIRONMENT VARIABLES
# ==========================================

# Environment Mode
NODE_ENV=development
PORT=4000
FRONTEND_PORT=3001
API_BASE_URL=http://localhost:4000/api/v1
FRONTEND_URL=http://localhost:3001

# Database Configuration (PostgreSQL inside Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=ad_utility_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_secure_password@postgres:5432/ad_utility_db?schema=public

# Redis Configuration (inside Docker)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password
REDIS_URL=redis://:redis_secure_password@redis:6379

# Authentication & JWT Secrets
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# AI Gateway Configuration (OpenAI API Key - SERVER ONLY, NEVER EXPOSE TO FRONTEND)
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE
OPENAI_DEFAULT_MODEL=gpt-4o-mini
AI_DAILY_TOKEN_LIMIT=1000000

# Object Storage Credentials (S3 / Cloudflare R2 / MinIO local fallback)
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=http://minio:9000
STORAGE_BUCKET=utility-platform-assets
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1

# CORS Policy
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000,http://127.0.0.1:3001
